SERVER_PORT=8080
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGODB_DB=vsb
JWT_SECRET=your-jwt-secret
JWT_EXPIRATION=24h
LOG_LEVEL=info
# 请求/响应 body 日志模式：full（完整）/ masked（敏感字段脱敏，默认）/ off（仅长度）
LOG_BODY=masked
# 逗号分隔的 CORS 白名单，生产环境请设置为实际前端域名
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173